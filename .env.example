# Entorno local de la API de Inversiones.
# Copiar a `.env` y ajustar. NUNCA commitear el `.env` resultante.

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=cambiar-en-local

# --- API ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# --- Liquibase ---
# Dejar vacio para ejecutar las migraciones (comportamiento por defecto).
# Poner `false` para desactivar la ejecucion automatica de migraciones.
LIQUIBASE_ENABLED=true
