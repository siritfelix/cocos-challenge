<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Reglas de analisis estatico del proyecto - Constitucion, Principio I.
  Se aplican tanto a codigo principal como a codigo de test.
  Objetivo: legibilidad, consistencia y ausencia de codigo duplicado o muerto.

  Nota sobre la estructura de Checkstyle: solo los modulos de nivel "archivo"
  (NewlineAtEndOfFile, FileTabCharacter) cuelgan directamente de Checker; todos los
  modulos de nivel "sentencia" deben declararse dentro de TreeWalker.
-->
<module name="Checker">

    <property name="charset" value="UTF-8"/>
    <!-- severity=error: el analisis estatico es una puerta de calidad real del build
         (Principio I y Definition of Done), no un aviso informative. -->
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Modulos de nivel archivo -->
    <!-- Nota: no se usa FileTabCharacter porque el proyecto indenta con tabuladores
         (convencion heredada del scaffold de Spring Initializr). -->
    <module name="NewlineAtEndOfFile">
        <property name="lineSeparator" value="lf"/>
    </module>

    <!-- Modulos de nivel sentencia -->
    <module name="TreeWalker">

        <!-- Imports -->
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="CustomImportOrder">
            <!-- Convencion de imports del proyecto (estandar Spring Boot):
                 1. imports estaticos
                 2. java.*
                 3. el resto (jakarta.*, org.*, com.*, io.*, ar.*)
                 Cada grupo va separado por una linea en blanco y, dentro del
                 grupo, los imports van ordenados alfabeticamente. -->
            <property name="customImportOrderRules"
                      value="STATIC###STANDARD_JAVA_PACKAGE###THIRD_PARTY_PACKAGE"/>
            <property name="sortImportsInGroupAlphabetically" value="true"/>
            <property name="separateLineBetweenGroups" value="true"/>
        </module>

        <!-- Bloques y control de flujo -->
        <module name="NeedBraces"/>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>
        <module name="EmptyStatement"/>
        <module name="MissingSwitchDefault"/>
        <module name="FallThrough"/>
        <module name="EqualsHashCode"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="StringLiteralEquality"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>

        <!-- Nomenclatura: codigo en ingles, constantes en UPPER_SNAKE -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="LocalVariableName"/>
        <module name="ParameterName"/>
        <module name="MemberName"/>
        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>

        <!-- Tamano de metodos: el Principio I exige metodos cortos con una unica responsabilidad -->
        <module name="MethodLength">
            <property name="max" value="80"/>
        </module>
        <module name="ParameterNumber">
            <property name="max" value="5"/>
        </module>

        <!-- Codigo muerto.
             Nota: UnusedPrivateField y UnusedPrivateMethod no existen en Checkstyle
             10.21.4 (verificado contra el jar oficial, SHA1 coincidente con Maven
             Central); se omiten para no romper la ejecucion del plugin. -->
        <module name="UnusedLocalVariable"/>

        <!-- White space -->
        <module name="WhitespaceAfter"/>
        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyLambdas" value="true"/>
        </module>
        <module name="NoWhitespaceBefore"/>
        <module name="GenericWhitespace"/>
        <module name="MethodParamPad"/>
        <module name="ParenPad"/>

        <!-- Comentarios -->
        <module name="JavadocType">
            <property name="scope" value="public"/>
            <property name="allowMissingParamTags" value="true"/>
        </module>
        <module name="JavadocStyle">
            <property name="checkFirstSentence" value="false"/>
        </module>
        <module name="NonEmptyAtclauseDescription"/>

        <!-- Expresiones: prohiben double/float para importes (Principio II, FR-096) -->
        <module name="IllegalType">
            <property name="illegalClassNames"
                      value="java.lang.Double, java.lang.Float, double, float"/>
            <property name="tokens"
                      value="METHOD_DEF, PARAMETER_DEF, VARIABLE_DEF, RECORD_COMPONENT_DEF"/>
        </module>

    </module>

</module>
